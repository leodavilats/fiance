{
  "name": "fiance-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "lint:ui": "node tools/lint-ui.mjs",
    "test": "ng test --watch=false",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/ssr": "^22.1.4",
    "express": "^5.2.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "lmdb@3.0.13": true,
    "msgpackr-extract@3.0.3": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "lucide-angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
