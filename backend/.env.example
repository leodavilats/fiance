# Backend env
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (Railway injeta DATABASE_URL automaticamente no deploy)
# Local, sem definir, usa sqlite em backend/.cache/fiance.db
DATABASE_URL=

# Login com Google — audiences aceitas do id_token, separadas por vírgula.
# Inclua o Client ID Web (usado como serverClientId no app mobile) e, se
# quiser, os Client IDs Android/iOS também. console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=

# Segredo usado para assinar o JWT de sessão emitido após o login
JWT_SECRET=

# BRAPI — cotações e fundamentos de ações B3/FIIs/BDRs/ETFs (brapi.dev)
BRAPI_TOKEN=

# Universo agora é gerado dinamicamente via BRAPI /quote/list (ver
# app/core/universe.py) — isto aqui só é usado como fallback de
# emergência se a BRAPI cair. Lista curta, só blue chips essenciais.
DEFAULT_UNIVERSE=PETR4,VALE3,ITUB4,BBDC4,BBAS3,ABEV3,WEGE3,B3SA3,RENT3,SUZB3,EQTL3,RADL3,HGLG11,MXRF11,KNRI11,AAPL34,MSFT34,BOVA11,IVVB11

# Notificações push (mobile) — JSON completo (uma linha) da chave de conta de
# serviço do Firebase (Project Settings → Service Accounts → Generate new
# private key). Sem isso, os pushes são só logados, não enviados de verdade.
FIREBASE_SERVICE_ACCOUNT_JSON=
